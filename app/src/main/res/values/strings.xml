    <string name="tutorial_step1_title">Check Your NFC Status</string>
    <string name="tutorial_step1_body">Device NFC must be ON before activating or scanning tags. This top badge always shows whether NFC is ready.</string>
    <string name="tutorial_step2_title">Make a Tag in Simple Steps</string>
    <string name="tutorial_step2_body">Tap Make Tag, choose Socials (Instagram, TikTok, X, WhatsApp, and more) or another tag type, then enter your details.</string>
    <string name="tutorial_step3_title">Copy a Physical NFC Tag</string>
    <string name="tutorial_step3_body">Have a real NFC card or sticker? Use Copy Tag to hold it against your phone and clone its tag into TagLink.</string>
    <string name="tutorial_step4_title">Activate &amp; Tap Any Phone</string>
    <string name="tutorial_step4_body">Open Activate Tag, turn it on, and hold the back of your unlocked phone near another phone for 1 second to share.</string>
    <string name="tutorial_step5_title">One-Tap Shortcuts</string>
    <string name="tutorial_step5_body">Pin a Home Widget or Quick Settings Tile here so you can turn NFC sharing on or off without opening the app.</string>

